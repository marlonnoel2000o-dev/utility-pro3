local function switchTab(index)
    Tab1.BackgroundColor3 = Color3.fromRGB(30, 20, 45)
    Tab1.TextColor3 = Color3.fromRGB(180, 180, 200)
    Tab2.BackgroundColor3 = Color3.fromRGB(30, 20, 45)
    Tab2.TextColor3 = Color3.fromRGB(180, 180, 200)
    Tab3.BackgroundColor3 = Color3.fromRGB(30, 20, 45)
    Tab3.TextColor3 = Color3.fromRGB(180, 180, 200)
    Page1.Visible = false
    Page2.Visible = false
    Page3.Visible = false

    if index == 1 then
        Tab1.BackgroundColor3 = Color3.fromRGB(120, 50, 200)
        Tab1.TextColor3 = Color3.fromRGB(255, 255, 255)
        Page1.Visible = true
    elseif index == 2 then
        Tab2.BackgroundColor3 = Color3.fromRGB(120, 50, 200)
        Tab2.TextColor3 = Color3.fromRGB(255, 255, 255)
        Page2.Visible = true
    elseif index == 3 then
        Tab3.BackgroundColor3 = Color3.fromRGB(120, 50, 200)
        Tab3.TextColor3 = Color3.fromRGB(255, 255, 255)
        Page3.Visible = true
    end
end

Tab1.MouseButton1Click:Connect(function() switchTab(1) end)
